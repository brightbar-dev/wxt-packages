{
  "name": "@brightbar-dev/wxt-extpay",
  "version": "0.2.0",
  "description": "WXT module for ExtensionPay integration \u2014 content script injection, payment helpers, and config",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./helpers": {
      "types": "./dist/helpers.d.ts",
      "import": "./dist/helpers.js"
    },
    "./pro-status": {
      "types": "./dist/pro-status.d.ts",
      "import": "./dist/pro-status.js"
    }
  },
  "files": [
    "src",
    "dist",
    "index.js"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test tests/e2e/payment-flow.spec.ts",
    "test:e2e:payment": "playwright test tests/e2e/payment-full-flow.spec.ts",
    "test:all": "vitest run && playwright test tests/e2e/payment-flow.spec.ts"
  },
  "peerDependencies": {
    "extpay": "^3.0.0",
    "wxt": ">=0.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.19.0",
    "extpay": "^3.1.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wxt": "^0.21.4"
  },
  "license": "MIT"
}
